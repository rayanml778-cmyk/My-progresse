{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/backup.js": {
      "maxDuration": 60
    },
    "api/quota.js": {
      "maxDuration": 15
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/pay.js": {
      "maxDuration": 15
    },
    "api/report.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/dev-panel.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
